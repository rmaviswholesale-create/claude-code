# Copy this file to .env.deepseek and fill in your key
# Get your free DeepSeek API key at: https://platform.deepseek.com

# Your DeepSeek API key
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# Point Claude Code at the local LiteLLM proxy
ANTHROPIC_BASE_URL=http://localhost:4000
ANTHROPIC_API_KEY=sk-local-proxy

# Tell Claude Code which model to use (proxy maps this → deepseek-chat)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: also redirect the small/fast model requests
ANTHROPIC_SMALL_FAST_MODEL=claude-haiku-4-5-20251001
